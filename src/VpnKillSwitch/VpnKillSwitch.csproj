<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VpnKillSwitch</AssemblyName>
    <RootNamespace>VpnKillSwitch</RootNamespace>
    <Version>0.1.0</Version>
    <Product>VPN Kill Switch</Product>
    <!-- app.ico is generated by the app itself: run the exe with the "export-icon" switch (see App.xaml.cs). -->
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script is the engine; ship it next to the exe. -->
    <Content Include="..\..\script\vpn-killswitch.ps1" Link="vpn-killswitch.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\script\*.cmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
