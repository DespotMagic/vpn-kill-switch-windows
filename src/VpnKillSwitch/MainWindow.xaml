<Window x:Class="VpnKillSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VpnKillSwitch"
        Title="VPN Kill Switch" Width="1060" Height="840" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Geometry x:Key="CapMin">M0 5 h10</Geometry>
        <Geometry x:Key="CapMax">M0.5 0.5 h9 v9 h-9 z</Geometry>
        <Geometry x:Key="CapClose">M0 0 l10 10 M10 0 L0 10</Geometry>

        <!-- one removable entry in the "allowed" and "extra servers" lists -->
        <DataTemplate x:Key="EntryRow">
            <Border Background="#F7F7F7" CornerRadius="4" Padding="10,2,2,2" Margin="0,0,0,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="RemoveEntry_Click" ToolTip="Remove">
                        <local:VectorIcon Data="{StaticResource IcoClose}" IconSize="14" />
                    </Button>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource CapMin}" Click="Min_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource CapMax}" Click="Max_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource CaptionClose}" Tag="{StaticResource CapClose}" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Text="VPN Kill Switch" FontSize="12" VerticalAlignment="Center" />
                    <Border x:Name="TitleChip" Height="20" CornerRadius="10" Padding="8,0" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="TitleChipDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TitleChipText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Navigation ===== -->
                <DockPanel Margin="8,8,8,16">
                    <TextBlock x:Name="NavVersion" DockPanel.Dock="Bottom" Margin="12" FontSize="12" Foreground="{StaticResource Text2}" />
                    <StackPanel>
                        <RadioButton x:Name="NavStatus" Style="{StaticResource NavItem}" Tag="{StaticResource IcoTunnel}" Content="Status" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" Tag="{StaticResource IcoRules}" Content="Rules" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavApp" Style="{StaticResource NavItem}" Tag="{StaticResource IcoMonitor}" Content="App &amp; widget" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="{StaticResource IcoInfo}" Content="About" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>

                <!-- ===== Content ===== -->
                <Border Grid.Column="1" Background="{StaticResource ContentBg}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                    <Grid>

                        <!-- ================= STATUS ================= -->
                        <ScrollViewer x:Name="PageStatus" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="36,28,36,40">
                                <TextBlock Text="Status" Style="{StaticResource H1}" />

                                <Border x:Name="ErrorBar" Background="#FDE7E9" BorderBrush="#F1C4C7" BorderThickness="1" CornerRadius="6"
                                        Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
                                </Border>

                                <!-- Hero -->
                                <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <Grid Margin="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="64" Height="64" VerticalAlignment="Center">
                                                <Ellipse x:Name="HeroCircle" />
                                                <local:VectorIcon x:Name="HeroGlyph" IconSize="36" StrokeThickness="2.2"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="HeroTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HeroDesc" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <WrapPanel x:Name="ChipRow" Margin="0,12,0,0">
                                                    <Border x:Name="ChipVpn" Style="{StaticResource Chip}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="ChipVpnDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="ChipVpnText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="ChipSince" Style="{StaticResource Chip}">
                                                        <TextBlock x:Name="ChipSinceText" FontSize="12" Foreground="{StaticResource Text3}" VerticalAlignment="Center" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="KsLabel" Text="Kill switch" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <CheckBox x:Name="KsSwitch" Style="{StaticResource SwitchLarge}" Click="KsSwitch_Click" />
                                                <Button x:Name="BtnReapplyNow" Style="{StaticResource BtnAccent}" Content="Re-apply now"
                                                        Click="Reapply_Click" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#FAFAFA" BorderBrush="#EDEDED" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24,12">
                                            <DockPanel>
                                                <Button x:Name="BtnReapply" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Reapply_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:VectorIcon Data="{StaticResource IcoRefresh}" IconSize="16" StrokeThickness="1.8"
                                                                          Stroke="{StaticResource Text}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Re-apply rules" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="FooterText" Style="{StaticResource Sub13}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Two cards -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="VPN tunnel" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Traffic inside the tunnel is not touched" Style="{StaticResource Sub13}" Margin="0,0,0,12" />
                                            <ItemsControl x:Name="ActiveVpnList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F3FAF2" BorderBrush="#CDEBCB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                            <DockPanel>
                                                                <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoLock}" IconSize="20" StrokeThickness="1.8"
                                                                                  Stroke="{StaticResource Green}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                <TextBlock DockPanel.Dock="Right" Text="Active" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource GreenText}" VerticalAlignment="Center" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="Connected" FontSize="12" Foreground="{StaticResource Text3}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl x:Name="IdleVpnList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="4,8">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource Text2}" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="VpnNone" Style="{StaticResource Sub13}" Margin="0,4,0,0"
                                                       Text="No VPN adapter found. If your VPN is installed, adjust the adapter pattern under Rules." />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Blocked adapters" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="BlockedSub" Style="{StaticResource Sub13}" Margin="0,0,0,12" />
                                            <ItemsControl x:Name="BlockedList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="4,8">
                                                            <DockPanel>
                                                                <local:VectorIcon DockPanel.Dock="Left" Data="{Binding Icon}" IconSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="12"
                                                                           Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Servers -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Add a server"
                                                    VerticalAlignment="Bottom" Click="GoRules_Click" />
                                            <StackPanel>
                                                <TextBlock Text="Allowed VPN servers" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="Pinned in the hosts file so the VPN can reconnect" Style="{StaticResource Sub13}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border x:Name="ServerHeader" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Host name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                                                <TextBlock Grid.Column="1" Text="IP address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                                                <TextBlock Grid.Column="2" Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl x:Name="ServerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="1.3*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{StaticResource Text2}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ServerNone" Style="{StaticResource Sub13}" Margin="0,4,0,0"
                                                   Text="Listed once the kill switch is on." />
                                    </StackPanel>
                                </Border>

                                <!-- Exceptions -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Edit rules"
                                                    VerticalAlignment="Center" Click="GoRules_Click" />
                                            <TextBlock x:Name="ExceptionsTitle" Text="Exceptions in effect" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <UniformGrid Columns="3">
                                            <Border Background="#F7F7F7" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Local network" Style="{StaticResource Sub}" />
                                                    <TextBlock x:Name="TileLan" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F7F7F7" CornerRadius="6" Padding="12" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="DNS to router" Style="{StaticResource Sub}" />
                                                    <TextBlock x:Name="TileDns" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F7F7F7" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Allowed without VPN" Style="{StaticResource Sub}" />
                                                    <TextBlock x:Name="TileAllowed" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= RULES ================= -->
                        <Grid x:Name="PageRules" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="36,28,36,24">
                                    <TextBlock Text="Rules" Style="{StaticResource H1}" />

                                    <!-- InfoBar -->
                                    <Border x:Name="InfoBar" Background="#EFF4F9" BorderBrush="#D3E1F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button x:Name="InfoBarBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="12,0,0,0" Click="InfoBarBtn_Click" />
                                            <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoInfo}" IconSize="18" StrokeThickness="1.8"
                                                              Stroke="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run x:Name="InfoBarBold" FontWeight="SemiBold" /><Run x:Name="InfoBarText" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="Kill switch" Style="{StaticResource GroupHeader}" Margin="0,12,0,6" />
                                    <Border Style="{StaticResource RowTop}">
                                        <DockPanel>
                                            <CheckBox x:Name="SwEnableOnStart" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                            <StackPanel>
                                                <TextBlock Text="Turn on when the app starts" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Rules already survive reboots - this only matters if you turned them off" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource RowBottom}">
                                        <DockPanel>
                                            <CheckBox x:Name="SwAutoCover" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                            <StackPanel>
                                                <TextBlock Text="Re-apply when a new network adapter appears" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Needs prompt-free switching - a new USB or tethering adapter is otherwise unprotected until you re-apply" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="What stays reachable without the VPN" Style="{StaticResource GroupHeader}" />
                                    <Border Style="{StaticResource RowTop}">
                                        <DockPanel>
                                            <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoHome}" IconSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <CheckBox x:Name="SwAllowLan" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="RuleChanged" />
                                            <StackPanel>
                                                <TextBlock Text="Local network" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Router, printer, NAS" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource RowMid}">
                                        <DockPanel>
                                            <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoGlobe}" IconSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <CheckBox x:Name="SwBlockDns" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="RuleChanged" />
                                            <StackPanel>
                                                <TextBlock Text="Block DNS to the router" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Prevents DNS leaks outside the tunnel" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource RowBottom}">
                                        <StackPanel>
                                            <DockPanel>
                                                <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoLink}" IconSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Allowed without VPN" />
                                                    <TextBlock Style="{StaticResource Sub}" Text="Host names, IP addresses or ranges such as 198.51.100.0/24. No wildcards or per-app rules." />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="36,12,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="#FBFBFB" Content="Add" Margin="8,0,0,0" Click="AddAllowed_Click" />
                                                <TextBox x:Name="TxtAllowed" Style="{StaticResource Input}" Tag="e.g. updates.example.com" KeyDown="TxtAllowed_KeyDown" />
                                            </DockPanel>
                                            <ItemsControl x:Name="AllowedList" Margin="36,10,0,0" ItemTemplate="{StaticResource EntryRow}" Tag="allowed" />
                                            <TextBlock x:Name="AllowedEmpty" Style="{StaticResource Sub13}" Margin="36,2,0,0" Text="Nothing added - everything goes through the VPN." />
                                            <TextBlock x:Name="AllowedNote" Style="{StaticResource Sub}" Margin="36,6,0,0"
                                                       Text="Reachable when the VPN is down; while it is connected they normally still use the tunnel. Host names are resolved when the rules are applied, and a site that loads parts from other domains may only work partly." />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="VPN servers" Style="{StaticResource GroupHeader}" />
                                    <Border Style="{StaticResource RowTop}">
                                        <DockPanel>
                                            <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoServer}" IconSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="View" VerticalAlignment="Center" Click="GoStatus_Click" />
                                            <StackPanel>
                                                <TextBlock Text="From Pritunl profiles" />
                                                <TextBlock x:Name="PritunlCount" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource RowBottom}">
                                        <StackPanel>
                                            <DockPanel>
                                                <local:VectorIcon DockPanel.Dock="Left" Data="{StaticResource IcoPlus}" IconSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Extra VPN servers" />
                                                    <TextBlock Style="{StaticResource Sub}" Text="For OpenVPN or WireGuard clients that aren't Pritunl" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="36,12,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="#FBFBFB" Content="Add" Margin="8,0,0,0" Click="AddServer_Click" />
                                                <TextBox x:Name="TxtServer" Style="{StaticResource Input}" Tag="Host name or IP address" KeyDown="TxtServer_KeyDown" />
                                            </DockPanel>
                                            <ItemsControl x:Name="ExtraServerList" Margin="36,10,0,0" ItemTemplate="{StaticResource EntryRow}" Tag="servers" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Advanced" Style="{StaticResource GroupHeader}" />
                                    <Border Style="{StaticResource RowSingle}">
                                        <StackPanel>
                                            <TextBlock Text="VPN adapter pattern" />
                                            <TextBlock Style="{StaticResource Sub}" Text="Regular expression matched against adapter name and description. Matching adapters are never blocked." />
                                            <TextBox x:Name="TxtPattern" Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                     Margin="0,10,0,0" TextChanged="TxtPattern_TextChanged" />
                                            <TextBlock x:Name="PatternMatches" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Save bar -->
                            <Border x:Name="SaveBar" Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                                    Padding="36,14" Visibility="Collapsed">
                                <DockPanel>
                                    <Button x:Name="BtnSave" DockPanel.Dock="Right" Style="{StaticResource BtnAccent}" Content="Save and re-apply" Margin="8,0,0,0" Click="Save_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="#FBFBFB" Content="Discard" Padding="16,0" Click="Discard_Click" />
                                    <TextBlock x:Name="SaveBarText" Text="You have unsaved changes" Style="{StaticResource Sub13}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ================= APP & WIDGET ================= -->
                        <ScrollViewer x:Name="PageApp" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="36,28,36,40">
                                <TextBlock Text="App &amp; widget" Style="{StaticResource H1}" />

                                <TextBlock Text="Startup" Style="{StaticResource GroupHeader}" Margin="0,0,0,6" />
                                <Border Style="{StaticResource RowTop}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwAutostart" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Start with Windows" />
                                            <TextBlock Style="{StaticResource Sub}" Text="Shows the tray icon and widget after you sign in" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowBottom}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwStartMin" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Start minimized to the tray" />
                                            <TextBlock Style="{StaticResource Sub}" Text="Do not open this window at startup" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Window" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource RowTop}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwCloseTray" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Close button hides the window to the tray" />
                                            <TextBlock Style="{StaticResource Sub}" Text="When off, closing the window exits the program (firewall rules stay active)" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowBottom}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwMinTray" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="AppSetting_Click" />
                                        <TextBlock Text="Minimize to the tray" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Desktop widget" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource RowTop}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwWidget" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="SwWidget_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Show the desktop widget" />
                                            <TextBlock Style="{StaticResource Sub}" Text="A small status pill with an on/off button. It appears while this window is closed to the tray or minimized." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowMid}">
                                    <DockPanel>
                                        <ComboBox x:Name="CmbCorner" DockPanel.Dock="Right" Width="160" Height="32" VerticalContentAlignment="Center"
                                                  Margin="16,0,0,0" SelectionChanged="CmbCorner_SelectionChanged">
                                            <ComboBoxItem Content="Top left" />
                                            <ComboBoxItem Content="Top right" />
                                            <ComboBoxItem Content="Bottom left" />
                                            <ComboBoxItem Content="Bottom right" />
                                        </ComboBox>
                                        <StackPanel>
                                            <TextBlock Text="Corner" />
                                            <TextBlock Style="{StaticResource Sub}" Text="You can also drag the widget; it snaps to the nearest corner" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowMid}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwWidgetTop" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="WidgetMode_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Keep above other windows" />
                                            <TextBlock Style="{StaticResource Sub}" Text="When off, windows can cover the widget; click the tray icon to bring it back" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowBottom}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwWidgetTaskbar" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="WidgetMode_Click" />
                                        <TextBlock Text="Show the widget in the taskbar" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="Administrator approval" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource RowSingle}">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="SwPromptFree" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0" Click="SwPromptFree_Click" />
                                            <StackPanel>
                                                <TextBlock Text="Prompt-free switching" />
                                                <TextBlock Style="{StaticResource Sub}"
                                                           Text="Approve once instead of every time you switch. Installs the script to Program Files and creates two scheduled tasks that run it with administrator rights." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button x:Name="BtnUpdateScript" Style="{StaticResource Btn}" Content="Update installed script" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" Visibility="Collapsed" Click="UpdateScript_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= ABOUT ================= -->
                        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="36,28,36,40">
                                <TextBlock Text="About" Style="{StaticResource H1}" />

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Image x:Name="AboutIcon" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,16,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="VPN Kill Switch" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Text2}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="What it does" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Para}" Text="While the kill switch is on, apps can reach the internet only through the VPN tunnel. If the VPN drops, traffic stops until it reconnects - nothing falls back to your normal connection." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="How it works" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Para}" Text="•  It adds block rules to Windows Firewall for every network adapter that is not a VPN adapter (Wi-Fi, Ethernet, tethering). Block rules win over every allow rule, so no program can get around them." />
                                        <TextBlock Style="{StaticResource Para}" Text="•  On those adapters only this stays reachable: your VPN servers (so the VPN can connect), your local network if enabled, and the addresses on your 'allowed without VPN' list." />
                                        <TextBlock Style="{StaticResource Para}" Text="•  Traffic inside the VPN adapter is not touched." />
                                        <TextBlock Style="{StaticResource Para}" Text="•  VPN server names are pinned in the hosts file, so the VPN can reconnect while DNS outside the tunnel is blocked." />
                                        <TextBlock Style="{StaticResource Para}" Text="•  The rules are stored by Windows. They survive reboots and stay active when this program is closed. This program only shows the state and runs vpn-killswitch.ps1 to switch." />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Works with" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Windows 10 and 11 where Windows Firewall (Windows Defender Firewall) is the active firewall." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Pritunl: servers are read from its profiles automatically." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Other OpenVPN and WireGuard clients that create their own network adapter: add their servers under Rules, and adjust the adapter pattern if the adapter is not recognised." />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Does not work with / limits" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Third-party firewalls or security suites that replace or switch off Windows Firewall: the rules are then not enforced." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  VPNs without their own network adapter (browser extensions, proxies)." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Split-tunnel VPN profiles: whatever the VPN does not route is blocked, not sent directly." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  Exceptions are by IP address only: no wildcard domains, no per-app exceptions." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  A newly plugged-in adapter is not covered until the rules are re-applied." />
                                            <TextBlock Style="{StaticResource Para}" Text="•  It protects against leaks, not against a program with administrator rights, which can remove the rules." />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Files" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="AboutFiles" Style="{StaticResource Para}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
