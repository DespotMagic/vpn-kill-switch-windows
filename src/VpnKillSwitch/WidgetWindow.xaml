<Window x:Class="VpnKillSwitch.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Kill Switch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- the outer margin leaves room for the shadow -->
    <Border x:Name="Pill" Margin="12" MinWidth="276" CornerRadius="12" Background="#232733" Padding="14,6,6,6"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            ToolTip="Drag to move - double-click to open - right-click for menu">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open VPN Kill Switch" Click="Open_Click" />
                <MenuItem Header="Widget settings..." Click="Settings_Click" />
                <Separator />
                <MenuItem Header="Top left" Tag="0" Click="Corner_Click" />
                <MenuItem Header="Top right" Tag="1" Click="Corner_Click" />
                <MenuItem Header="Bottom left" Tag="2" Click="Corner_Click" />
                <MenuItem Header="Bottom right" Tag="3" Click="Corner_Click" />
                <Separator />
                <MenuItem x:Name="MiOnTop" Header="Always on top" IsCheckable="True" Click="OnTop_Click" />
                <MenuItem x:Name="MiTaskbar" Header="Show in taskbar" IsCheckable="True" Click="Taskbar_Click" />
                <Separator />
                <MenuItem Header="Hide widget" Click="Hide_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel>
            <Button x:Name="Toggle" DockPanel.Dock="Right" Click="Toggle_Click" Cursor="Hand" Foreground="White"
                    FontWeight="Bold" FontSize="13" Margin="12,0,0,0" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="16" Height="32" Background="{TemplateBinding Background}" />
                            <Border x:Name="Shade" CornerRadius="16" Height="32" Background="#FFFFFF" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="Bold" FontSize="14" />
                <TextBlock x:Name="SubText" Foreground="#C8CCD4" FontSize="12" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
