<Window x:Class="VpnKillSwitch.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Kill Switch" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="488" Topmost="True"
        UseLayoutRounding="True" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Border Margin="24" Background="#FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8"
            MouseLeftButtonDown="Drag_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="24,20,24,16">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="BodyText" Foreground="{StaticResource Text3}" TextWrapping="Wrap" LineHeight="20" />
            </StackPanel>
            <Border Background="#F3F3F3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24,16">
                <UniformGrid x:Name="Buttons" Columns="2">
                    <Button x:Name="BtnConfirm" Style="{StaticResource BtnDanger}" Margin="0,0,4,0" Click="Confirm_Click" />
                    <Button x:Name="BtnCancel" Style="{StaticResource Btn}" Background="#FBFBFB" Content="Cancel" Margin="4,0,0,0"
                            IsCancel="True" IsDefault="True" Click="Cancel_Click" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
